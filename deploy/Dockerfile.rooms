FROM node:24-alpine@sha256:ebfe2f90462722a7a4de65e91990e97fe0d401c70e0e762c5b53302f905ec1c1 AS runner
WORKDIR /app
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev
COPY server/ ./server/
COPY src/collab/ ./src/collab/
COPY src/core/timer.ts src/core/model.ts src/core/wallpapers.ts ./src/core/
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8787/healthz || exit 1
WORKDIR /app/server
ENTRYPOINT ["node"]
CMD ["main.ts"]
